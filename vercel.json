{
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/downloads/(.*)", "destination": "/downloads/$1" },
    { "source": "/app/(.*)", "destination": "/app.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}