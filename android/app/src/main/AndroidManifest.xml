<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.transfo">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Foreground transfer notifications (Android 14+ requires the dataSync type). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- usesCleartextTraffic: the app talks to its PC over LAN http:// (no TLS certs) -->
  <application android:label="@string/app_name" android:name=".MainApplication" android:icon="@drawable/ic_launcher" android:usesCleartextTraffic="true">
    <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|keyboard|screenSize">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".service.TransferService" android:exported="false" android:foregroundServiceType="dataSync" />
  </application>
</manifest>
